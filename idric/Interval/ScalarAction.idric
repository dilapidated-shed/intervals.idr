module Interval.ScalarAction

import Interval.Exact

%unbound_implicits off

-- Scalar multiplication is an action of the exact rational line on its
-- intervals. It is structurally different from multiplying two intervals:
-- one operand is a scalar, so no cartesian product of two uncertain sets is
-- being pushed through a binary multiplication map.

public export
scale_rational : ExactRational → ExactRational → ExactRational
scale_rational
  (Ratio scalar_numerator scalar_denominator)
  (Ratio value_numerator value_denominator) =
    Ratio
      (scalar_numerator × value_numerator)
      (multiply_denominators scalar_denominator value_denominator)

-- These boundary maps remain public because checked propositions in separate
-- modules must be able to reduce through `scale_interval` definitionally.
public export
positive_scaled_lower : ExactRational → lower_bound → lower_bound
positive_scaled_lower _ unbounded_below = unbounded_below
positive_scaled_lower scalar (lower_at value kind) =
  lower_at (scale_rational scalar value) kind

public export
positive_scaled_upper : ExactRational → upper_bound → upper_bound
positive_scaled_upper _ unbounded_above = unbounded_above
positive_scaled_upper scalar (upper_at value kind) =
  upper_at (scale_rational scalar value) kind

-- A negative scalar reverses order. The old upper bound becomes the new lower
-- bound, and the old lower bound becomes the new upper bound. Endpoint
-- membership itself is preserved.
public export
negative_scaled_lower : ExactRational → upper_bound → lower_bound
negative_scaled_lower _ unbounded_above = unbounded_below
negative_scaled_lower scalar (upper_at value kind) =
  lower_at (scale_rational scalar value) kind

public export
negative_scaled_upper : ExactRational → lower_bound → upper_bound
negative_scaled_upper _ unbounded_below = unbounded_above
negative_scaled_upper scalar (lower_at value kind) =
  upper_at (scale_rational scalar value) kind

public export
scale_interval : ExactRational → exact_interval → exact_interval
scale_interval _ no_points = no_points
scale_interval scalar (points_between (Span lower upper _)) =
  let zero = whole 0
  in if rational_equal scalar zero
       then closed_interval zero zero
       else if rational_less zero scalar
         then make_interval
                (positive_scaled_lower scalar lower)
                (positive_scaled_upper scalar upper)
         else make_interval
                (negative_scaled_lower scalar upper)
                (negative_scaled_upper scalar lower)

public export
same_scaled_interval :
  ExactRational →
  exact_interval →
  exact_interval →
  Bool
same_scaled_interval scalar source expected =
  interval_equal (scale_interval scalar source) expected
