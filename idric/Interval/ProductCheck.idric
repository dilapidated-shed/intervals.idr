module Interval.ProductCheck

import Interval.Exact
import Interval.Product

%unbound_implicits off

exact_rational_product :
  rational_equal
    (multiply_rational
      (over 1 (OnePlus 1))
      (over 2 (OnePlus 2)))
    (over 1 (OnePlus 2)) = True
exact_rational_product = Refl

positive_product :
  same_product_result
    (multiply_intervals
      (closed_interval (whole 1) (whole 3))
      (closed_interval (whole 4) (whole 5)))
    (computed_product (closed_interval (whole 4) (whole 15))) = True
positive_product = Refl

negative_product :
  same_product_result
    (multiply_intervals
      (closed_interval (whole (-3)) (whole (-1)))
      (closed_interval (whole (-5)) (whole (-4))))
    (computed_product (closed_interval (whole 4) (whole 15))) = True
negative_product = Refl

sign_crossing_product :
  same_product_result
    (multiply_intervals
      (closed_interval (whole (-2)) (whole 3))
      (closed_interval (whole (-4)) (whole 5)))
    (computed_product (closed_interval (whole (-12)) (whole 15))) = True
sign_crossing_product = Refl

open_positive_product :
  same_product_result
    (multiply_intervals
      (open_interval (whole 0) (whole 2))
      (open_interval (whole 0) (whole 3)))
    (computed_product (open_interval (whole 0) (whole 6))) = True
open_positive_product = Refl

-- Zero is attained because the left factor contains zero. The upper product 6
-- is not attained because the left upper endpoint is excluded.
zero_attained_inside_product :
  same_product_result
    (multiply_intervals
      (right_open_interval (whole 0) (whole 2))
      (left_open_interval (whole 0) (whole 3)))
    (computed_product (right_open_interval (whole 0) (whole 6))) = True
zero_attained_inside_product = Refl

-- Endpoint products alone would mark zero excluded here because (-1,1) has
-- open endpoints. The zero singleton factor makes every actual product zero.
open_times_zero_singleton :
  same_product_result
    (multiply_intervals
      (open_interval (whole (-1)) (whole 1))
      (closed_interval (whole 0) (whole 0)))
    (computed_product (closed_interval (whole 0) (whole 0))) = True
open_times_zero_singleton = Refl

open_symmetric_product :
  same_product_result
    (multiply_intervals
      (open_interval (whole (-1)) (whole 1))
      (open_interval (whole (-1)) (whole 1)))
    (computed_product (open_interval (whole (-1)) (whole 1))) = True
open_symmetric_product = Refl

closed_symmetric_product :
  same_product_result
    (multiply_intervals
      (closed_interval (whole (-1)) (whole 1))
      (closed_interval (whole (-1)) (whole 1)))
    (computed_product (closed_interval (whole (-1)) (whole 1))) = True
closed_symmetric_product = Refl

empty_product :
  same_product_result
    (multiply_intervals no_points Interval.Exact.all_numbers)
    (computed_product no_points) = True
empty_product = Refl

-- Sign-sensitive unbounded products.

closed_positive_ray_product :
  same_product_result
    (multiply_intervals
      (above (whole 0) included)
      (closed_interval (whole 2) (whole 3)))
    (computed_product (above (whole 0) included)) = True
closed_positive_ray_product = Refl

open_positive_ray_product :
  same_product_result
    (multiply_intervals
      (above (whole 0) excluded)
      (open_interval (whole 0) (whole 2)))
    (computed_product (above (whole 0) excluded)) = True
open_positive_ray_product = Refl

negative_ray_times_positive :
  same_product_result
    (multiply_intervals
      (below (whole (-1)) included)
      (closed_interval (whole 2) (whole 3)))
    (computed_product (below (whole (-2)) included)) = True
negative_ray_times_positive = Refl

negative_ray_times_negative_ray :
  same_product_result
    (multiply_intervals
      (below (whole (-1)) included)
      (below (whole (-2)) included))
    (computed_product (above (whole 2) included)) = True
negative_ray_times_negative_ray = Refl

open_negative_rays_product :
  same_product_result
    (multiply_intervals
      (below (whole 0) excluded)
      (below (whole 0) excluded))
    (computed_product (above (whole 0) excluded)) = True
open_negative_rays_product = Refl

closed_negative_rays_product :
  same_product_result
    (multiply_intervals
      (below (whole 0) included)
      (below (whole 0) included))
    (computed_product (above (whole 0) included)) = True
closed_negative_rays_product = Refl

opposite_open_rays_product :
  same_product_result
    (multiply_intervals
      (above (whole 0) excluded)
      (below (whole 0) excluded))
    (computed_product (below (whole 0) excluded)) = True
opposite_open_rays_product = Refl

nonnegative_by_nonpositive :
  same_product_result
    (multiply_intervals
      (above (whole 0) included)
      (closed_interval (whole (-1)) (whole 0)))
    (computed_product (below (whole 0) included)) = True
nonnegative_by_nonpositive = Refl

mixed_lower_ray_times_positive_ray :
  same_product_result
    (multiply_intervals
      (above (whole (-1)) included)
      (above (whole 2) included))
    (computed_product Interval.Exact.all_numbers) = True
mixed_lower_ray_times_positive_ray = Refl

whole_line_times_nonzero :
  same_product_result
    (multiply_intervals
      Interval.Exact.all_numbers
      (closed_interval (whole 2) (whole 2)))
    (computed_product Interval.Exact.all_numbers) = True
whole_line_times_nonzero = Refl

whole_line_times_nonnegative :
  same_product_result
    (multiply_intervals
      Interval.Exact.all_numbers
      (closed_interval (whole 0) (whole 1)))
    (computed_product Interval.Exact.all_numbers) = True
whole_line_times_nonnegative = Refl

-- Zero annihilates even a two-sided unbounded interval. No 0×∞ placeholder is
-- introduced; the product is defined from finite members of the two sets.
whole_line_times_zero :
  same_product_result
    (multiply_intervals
      Interval.Exact.all_numbers
      (closed_interval (whole 0) (whole 0)))
    (computed_product (closed_interval (whole 0) (whole 0))) = True
whole_line_times_zero = Refl
