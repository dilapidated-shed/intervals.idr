module Interval.Exact

import Data.So

%unbound_implicits off

-- Signed whole numbers keep an Idriç-facing mathematical name. Integer is
-- only the inherited bootstrap representation at this compiler boundary.
public export
±Number : Type
±Number = Integer

-- Exact ordered scalar. A denominator is positive by construction.
-- No binary-float conversion or unproved rounding occurs in this module.
public export
data PositiveDenominator = OnePlus Number

public export
denominator_value : PositiveDenominator → ±Number
denominator_value (OnePlus n) = cast (S n)

public export
multiply_denominators : PositiveDenominator → PositiveDenominator → PositiveDenominator
multiply_denominators (OnePlus a) (OnePlus b) = OnePlus (a + b + a × b)

public export
data ExactRational = Ratio ±Number PositiveDenominator

public export
whole : ±Number → ExactRational
whole numerator = Ratio numerator (OnePlus 0)

-- `over 1 (OnePlus 3)` denotes 1/4. The successor avoids zero denominators.
public export
over : ±Number → PositiveDenominator → ExactRational
over = Ratio

public export
add_rational : ExactRational → ExactRational → ExactRational
add_rational (Ratio a b) (Ratio c d) =
  Ratio (a × denominator_value d + c × denominator_value b)
        (multiply_denominators b d)

public export
negate_rational : ExactRational → ExactRational
negate_rational (Ratio a b) = Ratio (-a) b

public export
subtract_rational : ExactRational → ExactRational → ExactRational
subtract_rational a b = add_rational a (negate_rational b)

public export
rational_equal : ExactRational → ExactRational → Bool
rational_equal (Ratio a b) (Ratio c d) =
  a × denominator_value d ≟ c × denominator_value b

public export
rational_less : ExactRational → ExactRational → Bool
rational_less (Ratio a b) (Ratio c d) =
  a × denominator_value d < c × denominator_value b

public export
rational_less_or_equal : ExactRational → ExactRational → Bool
rational_less_or_equal x y = rational_less x y || rational_equal x y

-- Endpoint inclusion is set membership data, not a nilpotent epsilon.
public export
choice endpoint_membership one_of
  included
  excluded

public export
is_included : endpoint_membership → Bool
is_included included = True
is_included excluded = False

public export
both_included : endpoint_membership → endpoint_membership → endpoint_membership
both_included included included = included
both_included _ _ = excluded

public export
choice lower_bound one_of
  unbounded_below
  lower_at ExactRational endpoint_membership

public export
choice upper_bound one_of
  upper_at ExactRational endpoint_membership
  unbounded_above

-- Evidence that a nonempty span's lower and upper bounds are compatible.
-- A caller may construct a span directly only by supplying one of these proofs.
public export
data ValidSpan : lower_bound → upper_bound → Type where
  UnboundedBelow :
    {upper_boundary : upper_bound} →
    ValidSpan unbounded_below upper_boundary

  UnboundedAbove :
    {lower_boundary : lower_bound} →
    ValidSpan lower_boundary unbounded_above

  StrictlyOrdered :
    {lower_value, upper_value : ExactRational} →
    {lower_kind, upper_kind : endpoint_membership} →
    So (rational_less lower_value upper_value) →
    ValidSpan
      (lower_at lower_value lower_kind)
      (upper_at upper_value upper_kind)

  ClosedSingleton :
    {lower_value, upper_value : ExactRational} →
    So (rational_equal lower_value upper_value) →
    ValidSpan
      (lower_at lower_value included)
      (upper_at upper_value included)

public export
record ValidatedSpan where
  constructor MkValidatedSpan
  lower_boundary : lower_bound
  upper_boundary : upper_bound
  validity : ValidSpan lower_boundary upper_boundary

-- `points_between` no longer accepts an arbitrary pair of bounds. Its payload
-- carries evidence that the span is nonempty and correctly ordered.
public export
choice exact_interval one_of
  no_points
  points_between ValidatedSpan

singleton_interval :
  (lower_kind, upper_kind : endpoint_membership) →
  (lower_value, upper_value : ExactRational) →
  So (rational_equal lower_value upper_value) →
  exact_interval
singleton_interval included included lower_value upper_value equality =
  points_between
    (MkValidatedSpan
      (lower_at lower_value included)
      (upper_at upper_value included)
      (ClosedSingleton equality))
singleton_interval _ _ _ _ _ = no_points

public export
make_interval : lower_bound → upper_bound → exact_interval
make_interval unbounded_below upper_boundary =
  points_between
    (MkValidatedSpan unbounded_below upper_boundary UnboundedBelow)
make_interval lower_boundary unbounded_above =
  points_between
    (MkValidatedSpan lower_boundary unbounded_above UnboundedAbove)
make_interval
  (lower_at lower_value lower_kind)
  (upper_at upper_value upper_kind) =
    case choose (rational_less lower_value upper_value) of
      Left strict_ordering =>
        points_between
          (MkValidatedSpan
            (lower_at lower_value lower_kind)
            (upper_at upper_value upper_kind)
            (StrictlyOrdered strict_ordering))
      Right _ =>
        case choose (rational_equal lower_value upper_value) of
          Left equality =>
            singleton_interval
              lower_kind
              upper_kind
              lower_value
              upper_value
              equality
          Right _ => no_points

public export
closed_interval : ExactRational → ExactRational → exact_interval
closed_interval lower_value upper_value =
  make_interval
    (lower_at lower_value included)
    (upper_at upper_value included)

public export
open_interval : ExactRational → ExactRational → exact_interval
open_interval lower_value upper_value =
  make_interval
    (lower_at lower_value excluded)
    (upper_at upper_value excluded)

public export
left_open_interval : ExactRational → ExactRational → exact_interval
left_open_interval lower_value upper_value =
  make_interval
    (lower_at lower_value excluded)
    (upper_at upper_value included)

public export
right_open_interval : ExactRational → ExactRational → exact_interval
right_open_interval lower_value upper_value =
  make_interval
    (lower_at lower_value included)
    (upper_at upper_value excluded)

public export
all_numbers : exact_interval
all_numbers = make_interval unbounded_below unbounded_above

public export
below : ExactRational → endpoint_membership → exact_interval
below upper_value membership =
  make_interval unbounded_below (upper_at upper_value membership)

public export
above : ExactRational → endpoint_membership → exact_interval
above lower_value membership =
  make_interval (lower_at lower_value membership) unbounded_above

public export
open_left : exact_interval → exact_interval
open_left no_points = no_points
open_left
  (points_between
    (MkValidatedSpan unbounded_below upper_boundary _)) =
      make_interval unbounded_below upper_boundary
open_left
  (points_between
    (MkValidatedSpan (lower_at lower_value _) upper_boundary _)) =
      make_interval
        (lower_at lower_value excluded)
        upper_boundary

public export
open_right : exact_interval → exact_interval
open_right no_points = no_points
open_right
  (points_between
    (MkValidatedSpan lower_boundary unbounded_above _)) =
      make_interval lower_boundary unbounded_above
open_right
  (points_between
    (MkValidatedSpan lower_boundary (upper_at upper_value _) _)) =
      make_interval
        lower_boundary
        (upper_at upper_value excluded)

public export
lower_allows : lower_bound → ExactRational → Bool
lower_allows unbounded_below _ = True
lower_allows (lower_at lower_value included) value =
  rational_less_or_equal lower_value value
lower_allows (lower_at lower_value excluded) value =
  rational_less lower_value value

public export
upper_allows : upper_bound → ExactRational → Bool
upper_allows unbounded_above _ = True
upper_allows (upper_at upper_value included) value =
  rational_less_or_equal value upper_value
upper_allows (upper_at upper_value excluded) value =
  rational_less value upper_value

public export
contains : exact_interval → ExactRational → Bool
contains no_points _ = False
contains
  (points_between
    (MkValidatedSpan lower_boundary upper_boundary _))
  value =
    lower_allows lower_boundary value &&
    upper_allows upper_boundary value

public export
same_membership : endpoint_membership → endpoint_membership → Bool
same_membership included included = True
same_membership excluded excluded = True
same_membership _ _ = False

public export
same_lower : lower_bound → lower_bound → Bool
same_lower unbounded_below unbounded_below = True
same_lower
  (lower_at left_value left_kind)
  (lower_at right_value right_kind) =
    rational_equal left_value right_value &&
    same_membership left_kind right_kind
same_lower _ _ = False

public export
same_upper : upper_bound → upper_bound → Bool
same_upper unbounded_above unbounded_above = True
same_upper
  (upper_at left_value left_kind)
  (upper_at right_value right_kind) =
    rational_equal left_value right_value &&
    same_membership left_kind right_kind
same_upper _ _ = False

public export
interval_equal : exact_interval → exact_interval → Bool
interval_equal no_points no_points = True
interval_equal
  (points_between
    (MkValidatedSpan left_lower left_upper _))
  (points_between
    (MkValidatedSpan right_lower right_upper _)) =
      same_lower left_lower right_lower &&
      same_upper left_upper right_upper
interval_equal _ _ = False

-- Set-valued/Minkowski addition. No probabilistic independence is assumed.
public export
add_lower : lower_bound → lower_bound → lower_bound
add_lower unbounded_below _ = unbounded_below
add_lower _ unbounded_below = unbounded_below
add_lower
  (lower_at left_value left_kind)
  (lower_at right_value right_kind) =
    lower_at
      (add_rational left_value right_value)
      (both_included left_kind right_kind)

public export
add_upper : upper_bound → upper_bound → upper_bound
add_upper unbounded_above _ = unbounded_above
add_upper _ unbounded_above = unbounded_above
add_upper
  (upper_at left_value left_kind)
  (upper_at right_value right_kind) =
    upper_at
      (add_rational left_value right_value)
      (both_included left_kind right_kind)

public export
add_interval : exact_interval → exact_interval → exact_interval
add_interval no_points _ = no_points
add_interval _ no_points = no_points
add_interval
  (points_between (MkValidatedSpan left_lower left_upper _))
  (points_between (MkValidatedSpan right_lower right_upper _)) =
    make_interval
      (add_lower left_lower right_lower)
      (add_upper left_upper right_upper)

public export
lower_of_negated_upper : upper_bound → lower_bound
lower_of_negated_upper unbounded_above = unbounded_below
lower_of_negated_upper (upper_at value membership) =
  lower_at (negate_rational value) membership

public export
upper_of_negated_lower : lower_bound → upper_bound
upper_of_negated_lower unbounded_below = unbounded_above
upper_of_negated_lower (lower_at value membership) =
  upper_at (negate_rational value) membership

public export
negate_interval : exact_interval → exact_interval
negate_interval no_points = no_points
negate_interval
  (points_between
    (MkValidatedSpan lower_boundary upper_boundary _)) =
      make_interval
        (lower_of_negated_upper upper_boundary)
        (upper_of_negated_lower lower_boundary)

-- Ordinary interval subtraction loses repeated-expression correlation.
-- `x:[0,1]` and `x−x` evaluate to `[-1,1]` here, not the singleton zero.
public export
subtract_interval : exact_interval → exact_interval → exact_interval
subtract_interval left right =
  add_interval left (negate_interval right)

-- Intersection is restriction by known set bounds, not statistical conditioning.
public export
stronger_lower : lower_bound → lower_bound → lower_bound
stronger_lower unbounded_below right = right
stronger_lower left unbounded_below = left
stronger_lower
  (lower_at left_value left_kind)
  (lower_at right_value right_kind) =
    if rational_less left_value right_value
      then lower_at right_value right_kind
      else if rational_less right_value left_value
        then lower_at left_value left_kind
        else lower_at left_value (both_included left_kind right_kind)

public export
stronger_upper : upper_bound → upper_bound → upper_bound
stronger_upper unbounded_above right = right
stronger_upper left unbounded_above = left
stronger_upper
  (upper_at left_value left_kind)
  (upper_at right_value right_kind) =
    if rational_less left_value right_value
      then upper_at left_value left_kind
      else if rational_less right_value left_value
        then upper_at right_value right_kind
        else upper_at left_value (both_included left_kind right_kind)

public export
intersect_interval : exact_interval → exact_interval → exact_interval
intersect_interval no_points _ = no_points
intersect_interval _ no_points = no_points
intersect_interval
  (points_between (MkValidatedSpan left_lower left_upper _))
  (points_between (MkValidatedSpan right_lower right_upper _)) =
    make_interval
      (stronger_lower left_lower right_lower)
      (stronger_upper left_upper right_upper)
