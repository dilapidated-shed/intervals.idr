module Interval.Check

import Data.So
import Interval.Exact

%unbound_implicits off

-- Every equality ending in Refl must be checked by Idriç, not merely printed.
plus_closed :
  interval_equal
    (add_interval (closed_interval (whole 1) (whole 3))
                  (closed_interval (whole 4) (whole 9)))
    (closed_interval (whole 5) (whole 12)) = True
plus_closed = Refl

plus_open :
  interval_equal
    (add_interval (right_open_interval (whole 1) (whole 3))
                  (left_open_interval (whole 4) (whole 9)))
    (open_interval (whole 5) (whole 12)) = True
plus_open = Refl

subtract_extremes :
  interval_equal
    (subtract_interval (closed_interval (whole 1) (whole 3))
                       (closed_interval (whole 4) (whole 9)))
    (closed_interval (whole (-8)) (whole (-1))) = True
subtract_extremes = Refl

-- Explicit record of the dependency problem, not a false proof of x−x=0.
dependency_is_lost :
  interval_equal
    (subtract_interval (closed_interval (whole 0) (whole 1))
                       (closed_interval (whole 0) (whole 1)))
    (closed_interval (whole (-1)) (whole 1)) = True
dependency_is_lost = Refl

empty_open_singleton :
  interval_equal (open_interval (whole 1) (whole 1)) no_points = True
empty_open_singleton = Refl

empty_inverted :
  interval_equal (closed_interval (whole 3) (whole 1)) no_points = True
empty_inverted = Refl

open_lower_not_member :
  contains (left_open_interval (whole 1) (whole 3)) (whole 1) = False
open_lower_not_member = Refl

closed_lower_member :
  contains (closed_interval (whole 1) (whole 3)) (whole 1) = True
closed_lower_member = Refl

open_right_not_member :
  contains (right_open_interval (whole 1) (whole 3)) (whole 3) = False
open_right_not_member = Refl

unbounded_contains_negative :
  contains (below (whole 4) excluded) (whole (-100)) = True
unbounded_contains_negative = Refl

unbounded_excludes_endpoint :
  contains (below (whole 4) excluded) (whole 4) = False
unbounded_excludes_endpoint = Refl

empty_absorbs_addition :
  interval_equal (add_interval no_points Interval.Exact.all_numbers) no_points = True
empty_absorbs_addition = Refl

opposite_infinite_rays_sum_all :
  interval_equal
    (add_interval (above (whole 0) included)
                  (below (whole 0) included))
    Interval.Exact.all_numbers = True
opposite_infinite_rays_sum_all = Refl

intersection_open_boundary_empty :
  interval_equal
    (intersect_interval (closed_interval (whole 0) (whole 1))
                        (left_open_interval (whole 1) (whole 2)))
    no_points = True
intersection_open_boundary_empty = Refl

intersection_singleton :
  interval_equal
    (intersect_interval (closed_interval (whole 0) (whole 1))
                        (closed_interval (whole 1) (whole 2)))
    (closed_interval (whole 1) (whole 1)) = True
intersection_singleton = Refl

exact_quarters :
  rational_equal
    (add_rational (over 1 (OnePlus 3)) (over 1 (OnePlus 3)))
    (over 1 (OnePlus 1)) = True
exact_quarters = Refl

-- Direct construction is possible only when the requested span carries a
-- proof of validity. `Oh` typechecks here because 1 < 3 reduces to True.
direct_strict_span :
  interval_equal
    (points_between
      (Span
        (lower_at (whole 1) included)
        (upper_at (whole 3) included)
        (StrictFinite Oh)))
    (closed_interval (whole 1) (whole 3)) = True
direct_strict_span = Refl

-- Equal endpoints form a nonempty interval only through the closed-singleton
-- evidence constructor.
direct_closed_singleton :
  interval_equal
    (points_between
      (Span
        (lower_at (whole 2) included)
        (upper_at (whole 2) included)
        (EqualClosed Oh)))
    (closed_interval (whole 2) (whole 2)) = True
direct_closed_singleton = Refl

main : IO ()
main = putStrLn "Idriç exact rational interval checks: PASS"
